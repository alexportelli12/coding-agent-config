{
  "$schema": "https://opencode.ai/config.json",
  "agent": {
    "general": {
      "model": "openai/gpt-5.6-luna"
    },
    "documentation": {
      "description": "Write and maintain concise documentation for AI agents",
      "mode": "subagent",
      "model": "openai/gpt-5.6-luna",
      "prompt": "{file:./agent/documentation.md}"
    },
    "ui-designer": {
      "description": "Design and implement repository-grounded UI with practical targeted rendered validation",
      "mode": "subagent",
      "model": "opencode-go/kimi-k2.7-code",
      "prompt": "{file:./agent/ui-designer.md}",
      "permission": { "skill": "allow" }
    },
    "code-reviewer": {
      "description": "Independently review completed changes using OCR Delegation Mode, including UI/UX when relevant",
      "mode": "subagent",
      "prompt": "{file:./agent/code-reviewer.md}",
      "permission": {
        "read": "allow",
        "edit": "deny",
        "bash": {
          "*": "deny",
          "ocr delegate preview*": "allow",
          "ocr delegate rule*": "allow",
          "git status*": "allow",
          "git diff*": "allow",
          "git show*": "allow",
          "git log*": "allow",
          "git rev-parse*": "allow",
          "git ls-files*": "allow"
        },
        "task": "deny",
        "skill": "allow",
        "webfetch": "deny",
        "playwright_*": "allow"
      }
    },
    "explore": {
      "model": "openai/gpt-5.6-luna",
      "permission": {
        "bash": {
          "*": "deny",
          "git status*": "allow",
          "git diff*": "allow",
          "git log*": "allow",
          "git show*": "allow",
          "git rev-parse*": "allow",
          "git ls-files*": "allow",
          "git rev-list*": "allow",
          "git blame*": "allow",
          "git branch --list*": "allow",
          "git worktree list*": "allow",
          "git describe*": "allow",
          "rg": "allow",
          "rg *": "allow",
          "grep": "allow",
          "grep *": "allow",
          "ls": "allow",
          "ls *": "allow",
          "find": "allow",
          "find *": "allow",
          "wc": "allow",
          "wc *": "allow",
          "head": "allow",
          "head *": "allow",
          "tail": "allow",
          "tail *": "allow"
        }
      }
    }
  },
  "permission": {
    "external_directory": {
      "~/.local/share/opencode/implementation-worktrees/**": "allow",
      "~/.local/share/coding-agent/implementation-worktrees/**": "allow"
    }
  },
  "mcp": {
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@playwright/mcp@latest",
        "--headless",
        "--isolated",
        "--executable-path=/usr/bin/chromium",
        "--output-dir=/tmp/opencode-playwright",
        "--output-max-size=5242880"
      ],
      "enabled": true
    }
  }
}
