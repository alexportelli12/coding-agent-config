{
  "$schema": "https://opencode.ai/config.json",
  "agent": {
    "general": {
      "model": "openai/gpt-5.6-luna"
    },
    "explore": {
      "model": "openai/gpt-5.6-luna"
    }
  },
  "mcp": {
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@playwright/mcp@latest",
        "--headless",
        "--isolated",
        "--output-dir=/tmp/opencode-playwright",
        "--output-max-size=5242880"
      ],
      "enabled": true
    }
  }
}
