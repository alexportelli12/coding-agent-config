{
  "$schema": "https://opencode.ai/config.json",
  "agent": {
    "general": {
      "model": "openai/gpt-5.6-luna"
    },
    "explore": {
      "model": "openai/gpt-5.6-luna",
      "permission": {
        "bash": {
          "*": "deny",
          "git status*": "allow",
          "git diff*": "allow",
          "git log*": "allow",
          "git show*": "allow",
          "git rev-parse*": "allow",
          "git ls-files*": "allow",
          "git rev-list*": "allow",
          "git blame*": "allow",
          "git branch --list*": "allow",
          "git worktree list*": "allow",
          "git describe*": "allow",
          "rg": "allow",
          "rg *": "allow",
          "grep": "allow",
          "grep *": "allow",
          "ls": "allow",
          "ls *": "allow",
          "find": "allow",
          "find *": "allow",
          "wc": "allow",
          "wc *": "allow",
          "head": "allow",
          "head *": "allow",
          "tail": "allow",
          "tail *": "allow"
        }
      }
    }
  },
  "plugin": ["./plugins/verify-env.mjs"],
  "permission": {
    "external_directory": {
      "~/.local/share/opencode/implementation-worktrees/**": "allow"
    }
  },
  "mcp": {
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@playwright/mcp@latest",
        "--headless",
        "--isolated",
        "--executable-path=/usr/bin/chromium",
        "--output-dir=/tmp/opencode-playwright",
        "--output-max-size=5242880"
      ],
      "enabled": true
    }
  }
}
